{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TabVault",
  "version": "1.0.0",
  "identifier": "com.tabvault.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "TabVault",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"],
    "publisher": "TabVault Contributors",
    "homepage": "https://github.com/tabvault/tabvault",
    "copyright": "Copyright (c) 2026 TabVault Contributors. MIT License.",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../target/release/tabvault-host.exe": "tabvault-host.exe"
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerHooks": "nsis-hook.nsh"
      }
    }
  }
}
